{
    "name": "blog-hub",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "test": "playwright test",
        "validate:local": "node scripts/run-isolated-validation.cjs",
        "test:unit:js": "node --test tests/unit/*.test.js",
        "test:playwright:ci": "bash scripts/run-playwright-tests.sh",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "generate:types": "node scripts/generate-types.mjs",
        "generate:settings-assets": "node screens/settings/build-assets.mjs",
        "check:settings-assets": "node screens/settings/build-assets.mjs --check",
        "check:types": "tsc --project tsconfig.contracts.json --noEmit",
        "check:contracts": "npm run check:settings-assets && npm run generate:types && npm run check:types"
    },
    "devDependencies": {
        "@fontsource/inter": "5.3.0",
        "@fontsource/jetbrains-mono": "5.3.0",
        "@playwright/test": "^1.43.0",
        "openapi-typescript": "^7.13.0",
        "tailwindcss": "3.4.17",
        "typescript": "^5.9.3"
    }
}
