{
    "name": "blog-hub",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "test": "playwright test",
        "test:unit:js": "node --test tests/unit/*.test.js",
        "test:playwright:ci": "bash scripts/run-playwright-tests.sh",
        "test:headed": "playwright test --headed",
        "test:debug": "playwright test --debug",
        "generate:types": "node scripts/generate-types.mjs",
        "check:types": "tsc --project tsconfig.contracts.json --noEmit",
        "check:contracts": "npm run generate:types && npm run check:types"
    },
    "devDependencies": {
        "@playwright/test": "^1.43.0",
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.9.3"
    }
}
